# 保持跨编辑器一致的缩进与换行（与 .gitattributes 配合）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
