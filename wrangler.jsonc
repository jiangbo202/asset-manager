{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asset-manager",
  "main": "./src/worker/index.ts",
  // 设为今天的日期（首次创建项目时）
  "compatibility_date": "2026-09-20",
  "assets": {
    // directory 由 Vite 插件的客户端构建产物自动决定，无需手写
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // 上游模板仓库里保持占位值；你自己的副本（克隆 / 一键部署产物）里应该是真实 id：
      // - 命令行路径：`npm run setup:d1` 创建/查找到真实 id 后回写本文件（本地改动不必提交）
      // - 一键部署：Cloudflare 向导按这里的绑定创建 D1 并回写真实 id
      // 直接拿占位值部署会在绑定 D1 时报错，这是有意的：提示你先建库。
      "database_name": "asset-manager-db",
      "database_id": "5de5408e-5a3f-4764-9600-cb1a95fb7e0e",
      "migrations_dir": "migrations"
    }
  ],
  // 每小时触发一次：只有"配置的快照小时"才会真正干活（见 src/worker/services/scheduler.ts）
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
